# ===================================================================
# PetitionLetter backend configuration
# Copy to backend/.env and edit. Every key here is read by
# app/core/config.py (Settings); nothing else is.
# ===================================================================

# ---- LLM ---------------------------------------------------------
# Default provider used when a request does not specify one: deepseek | openai | anthropic
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_API_BASE=https://api.openai.com/v1

# ANTHROPIC_API_KEY=sk-ant-your-key          # native Messages API (claude-opus-5 by default)
# ANTHROPIC_API_BASE=

# Content-addressed response cache in data/llm_cache: re-running the same
# request returns the stored answer (dev: true so UI iteration does not
# re-burn minutes and dollars; prod: false).
LLM_CACHE_ENABLED=true
# One JSONL line per LLM call in data/traces/{date}.jsonl (caller, model,
# prompt_id, tokens, latency, cost). Query with jq.
LLM_TRACE_ENABLED=true

# ---- Workspaces / auth (Doc M5) -----------------------------------
# true  : local development, no tokens needed (falls back to the "default"
#         workspace); a valid token is still honoured.
# false : every /api request needs "Authorization: Bearer <token>"; mint
#         tokens with  python scripts/mint_token.py --label P07
AUTH_DISABLED=true

# ---- HTTP ---------------------------------------------------------
# Comma-separated CORS allow-list (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# ---- Paths --------------------------------------------------------
# Root of application data (projects, workspaces, logs, traces). Empty -> backend/data
# DATA_DIR=
# Root of the original case material (PDFs) that metadata.json.source_path
# points into. Empty -> <repo>/data. Docker sets /app/data.
# SOURCE_DATA_DIR=

# ---- Logging ------------------------------------------------------
LOG_LEVEL=INFO

# ---- Test / debug --------------------------------------------------
# Start the server even when the configured provider has no key.
# Used by the test suite; do not set in production.
# SKIP_LLM_CONFIG_CHECK=false

# ---- Study platform -------------------------------------------
# gpt-5.6-luna is served on the Responses API, which is a different
# provider entry from the chat/completions one.
LLM_PROVIDER=openai_responses
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
